
# =========================================================
# MUSICALWORLD — FFmpeg WASM REDUZIDO
#
# Objetivos:
# - Preparar vídeos de até 45 segundos ou mais, conforme
#   o corte solicitado pela aplicação.
# - Codificar vídeo H.264 e áudio AAC em MP4.
# - Ampliar a leitura de formatos comuns de vídeo e áudio.
# - Incluir os filtros utilizados no corte e na conversão.
# - Manter o WebAssembly abaixo de 25 MiB, se possível.
#
# IMPORTANTE:
# O tamanho final precisa ser conferido após a compilação.
# =========================================================

FROM emscripten/emsdk:3.1.40 AS emsdk-base

ARG EXTRA_CFLAGS=""
ARG EXTRA_LDFLAGS=""

ENV INSTALL_DIR=/opt
ENV FFMPEG_VERSION=n5.1.4
ENV FFMPEG_ST=yes
ENV CFLAGS="-I/opt/include ${EXTRA_CFLAGS}"
ENV CXXFLAGS="${CFLAGS}"
ENV LDFLAGS="-L/opt/lib ${CFLAGS} ${EXTRA_LDFLAGS}"
ENV EM_PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig
ENV PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      pkg-config autoconf automake libtool ragel git && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# 1. Compilar a biblioteca H.264
# ---------------------------------------------------------

FROM emsdk-base AS x264-builder

ENV X264_BRANCH=4-cores

ADD https://github.com/ffmpegwasm/x264.git#4-cores /src

COPY build/x264.sh /src/build.sh

RUN bash -x /src/build.sh

# ---------------------------------------------------------
# 2. Preparar o FFmpeg
# ---------------------------------------------------------

FROM emsdk-base AS ffmpeg-base

ADD https://github.com/FFmpeg/FFmpeg.git#n5.1.4 /src

COPY --from=x264-builder /opt /opt

# ---------------------------------------------------------
# 3. Compilar os componentes necessários
# ---------------------------------------------------------

FROM ffmpeg-base AS ffmpeg-builder

COPY build/ffmpeg.sh /src/build.sh

RUN bash -x /src/build.sh \
    --enable-gpl \
    --disable-everything \
    --enable-libx264 \
    \
    --enable-encoder=libx264 \
    --enable-encoder=aac \
    \
    --enable-decoder=h264 \
    --enable-decoder=hevc \
    --enable-decoder=mpeg4 \
    --enable-decoder=mpeg1video \
    --enable-decoder=mpeg2video \
    --enable-decoder=h263 \
    --enable-decoder=mjpeg \
    --enable-decoder=png \
    --enable-decoder=gif \
    --enable-decoder=bmp \
    --enable-decoder=webp \
    --enable-decoder=prores \
    --enable-decoder=flv \
    --enable-decoder=vp8 \
    --enable-decoder=vp9 \
    --enable-decoder=wmv1 \
    --enable-decoder=wmv2 \
    --enable-decoder=vc1 \
    --enable-decoder=theora \
    --enable-decoder=aac \
    --enable-decoder=mp3 \
    --enable-decoder=mp3float \
    --enable-decoder=opus \
    --enable-decoder=vorbis \
    --enable-decoder=flac \
    --enable-decoder=alac \
    --enable-decoder=ac3 \
    --enable-decoder=eac3 \
    --enable-decoder=dca \
    --enable-decoder=truehd \
    --enable-decoder=pcm_s16le \
    --enable-decoder=pcm_s16be \
    --enable-decoder=pcm_s24le \
    --enable-decoder=pcm_s24be \
    --enable-decoder=pcm_s32le \
    --enable-decoder=pcm_s32be \
    --enable-decoder=pcm_u8 \
    --enable-decoder=pcm_f32le \
    --enable-decoder=pcm_f64le \
    --enable-decoder=wmav1 \
    --enable-decoder=wmav2 \
    --enable-decoder=wmalossless \
    --enable-decoder=wmapro \
    \
    --enable-demuxer=mov \
    --enable-demuxer=matroska \
    --enable-demuxer=avi \
    --enable-demuxer=flv \
    --enable-demuxer=asf \
    --enable-demuxer=mpeg \
    --enable-demuxer=mpegts \
    --enable-demuxer=h264 \
    --enable-demuxer=hevc \
    --enable-demuxer=avi \
    --enable-demuxer=image2 \
    --enable-demuxer=image2pipe \
    --enable-demuxer=ogg \
    --enable-demuxer=flac \
    --enable-demuxer=mp3 \
    --enable-demuxer=wav \
    --enable-demuxer=aac \
    --enable-demuxer=ac3 \
    --enable-demuxer=dts \
    --enable-demuxer=amr \
    --enable-demuxer=ape \
    --enable-demuxer=wv \
    --enable-demuxer=rawvideo \
    \
    --enable-muxer=mp4 \
    \
    --enable-parser=h264 \
    --enable-parser=hevc \
    --enable-parser=mpeg4video \
    --enable-parser=mpegvideo \
    --enable-parser=h263 \
    --enable-parser=mjpeg \
    --enable-parser=png \
    --enable-parser=vp8 \
    --enable-parser=vp9 \
    --enable-parser=aac \
    --enable-parser=mpegaudio \
    --enable-parser=opus \
    --enable-parser=vorbis \
    --enable-parser=flac \
    --enable-parser=ac3 \
    --enable-parser=dca \
    \
    --enable-protocol=file \
    \
    --enable-filter=null \
    --enable-filter=anull \
    --enable-filter=trim \
    --enable-filter=atrim \
    --enable-filter=setpts \
    --enable-filter=asetpts \
    --enable-filter=scale \
    --enable-filter=format \
    --enable-filter=aformat \
    --enable-filter=fps \
    --enable-filter=setsar \
    --enable-filter=transpose \
    --enable-filter=crop \
    --enable-filter=pad \
    --enable-filter=split \
    --enable-filter=asplit \
    --enable-filter=concat \
    --enable-filter=colorspace \
    --enable-filter=aresample \
    --enable-filter=volume \
    --enable-filter=pan \
    --enable-filter=amix \
    --enable-filter=adelay \
    --enable-filter=apad \
    --enable-filter=asetnsamples \
    --enable-filter=amerge \
    --enable-filter=abuffer \
    --enable-filter=abuffersink

# ---------------------------------------------------------
# 4. Gerar o núcleo JavaScript/WebAssembly
# ---------------------------------------------------------

FROM ffmpeg-builder AS ffmpeg-wasm-builder

COPY src/bind /src/src/bind

COPY src/fftools /src/src/fftools

COPY build/ffmpeg-wasm.sh /src/build.sh

ENV FFMPEG_LIBS="-lx264"

RUN mkdir -p /src/dist/umd && \
    bash -x /src/build.sh ${FFMPEG_LIBS} \
      -o dist/umd/ffmpeg-core.js

# ---------------------------------------------------------
# 5. Exportar os arquivos compilados
# ---------------------------------------------------------

FROM scratch AS exportor

COPY --from=ffmpeg-wasm-builder /src/dist /dist

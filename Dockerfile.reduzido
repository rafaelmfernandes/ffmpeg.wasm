
# MusicalWorld — FFmpeg WASM reduzido
# Compilação no GitHub Actions; não exige Docker no Windows.

FROM emscripten/emsdk:3.1.40 AS emsdk-base

ARG EXTRA_CFLAGS=""
ARG EXTRA_LDFLAGS=""
ARG FFMPEG_ST=yes

ENV INSTALL_DIR=/opt
ENV FFMPEG_VERSION=n5.1.4
ENV FFMPEG_ST=yes
ENV CFLAGS="-I/opt/include ${EXTRA_CFLAGS}"
ENV CXXFLAGS="${CFLAGS}"
ENV LDFLAGS="-L/opt/lib ${CFLAGS} ${EXTRA_LDFLAGS}"
ENV EM_PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig
ENV PKG_CONFIG_PATH=/opt/lib/pkgconfig:/emsdk/upstream/emscripten/system/lib/pkgconfig

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      pkg-config autoconf automake libtool ragel git && \
    rm -rf /var/lib/apt/lists/*

# Compila a biblioteca de codificação H.264.
FROM emsdk-base AS x264-builder

ENV X264_BRANCH=4-cores
ADD https://github.com/ffmpegwasm/x264.git#4-cores /src
COPY build/x264.sh /src/build.sh
RUN bash -x /src/build.sh

# Baixa o FFmpeg e inclui apenas a biblioteca x264.
FROM emsdk-base AS ffmpeg-base

ADD https://github.com/FFmpeg/FFmpeg.git#n5.1.4 /src
COPY --from=x264-builder /opt /opt

# Reduz a lista de componentes de FFmpeg.
FROM ffmpeg-base AS ffmpeg-builder

COPY build/ffmpeg.sh /src/build.sh

RUN bash -x /src/build.sh \
    --enable-gpl \
    --disable-everything \
    --enable-libx264 \
    --enable-encoder=libx264 \
    --enable-encoder=aac \
    --enable-decoder=h264 \
    --enable-decoder=hevc \
    --enable-decoder=mpeg4 \
    --enable-decoder=mjpeg \
    --enable-decoder=vp8 \
    --enable-decoder=vp9 \
    --enable-decoder=aac \
    --enable-demuxer=mov \
    --enable-demuxer=matroska \
    --enable-demuxer=avi \
    --enable-demuxer=mpeg \
    --enable-demuxer=mpegts \
    --enable-demuxer=image2 \
    --enable-muxer=mp4 \
    --enable-parser=h264 \
    --enable-parser=hevc \
    --enable-parser=mpeg4video \
    --enable-parser=aac \
    --enable-protocol=file \
    --enable-filter=null \
    --enable-filter=format \
    --enable-filter=scale

# Gera o núcleo JavaScript/WebAssembly.
FROM ffmpeg-builder AS ffmpeg-wasm-builder

COPY src/bind /src/src/bind
COPY src/fftools /src/src/fftools
COPY build/ffmpeg-wasm.sh /src/build.sh

ENV FFMPEG_LIBS="-lx264"

RUN mkdir -p /src/dist/umd && \
    bash -x /src/build.sh ${FFMPEG_LIBS} \
      -o dist/umd/ffmpeg-core.js

FROM scratch AS exportor

COPY --from=ffmpeg-wasm-builder /src/dist /dist
